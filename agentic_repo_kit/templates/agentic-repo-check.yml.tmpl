# {{MARKER}}
name: Agentic repository contract

on:
  pull_request:
  push:

permissions:
  contents: read

concurrency:
  group: agentic-repo-check-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Resolve pinned kit artifact
        id: kit
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY' >> "$GITHUB_OUTPUT"
          import json
          from pathlib import Path
          import re
          from urllib.parse import quote

          lock = json.loads(Path(".agentic-repo.lock.json").read_text(encoding="utf-8"))
          if not isinstance(lock, dict) or lock.get("format") != 2:
              raise SystemExit("agentic-repo check workflow requires lock format 2")

          version = lock.get("tool_version")
          distribution = lock.get("distribution")
          if not isinstance(version, str) or not isinstance(distribution, dict):
              raise SystemExit("invalid agentic-repo distribution identity")

          repository = distribution.get("repository")
          release = distribution.get("release")
          artifact = distribution.get("artifact")
          digest = distribution.get("sha256")
          dist_version = distribution.get("tool_version")

          if dist_version != version:
              raise SystemExit("distribution tool_version does not match lock tool_version")
          if not isinstance(repository, str) or re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository) is None:
              raise SystemExit("invalid distribution repository")
          if not isinstance(release, str) or re.fullmatch(r"v[A-Za-z0-9._+-]+", release) is None:
              raise SystemExit("invalid distribution release")
          if not isinstance(artifact, str) or re.fullmatch(r"[A-Za-z0-9._+-]+\.pyz", artifact) is None:
              raise SystemExit("invalid distribution artifact")
          if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
              raise SystemExit("invalid distribution sha256")
          if release != f"v{version}":
              raise SystemExit("distribution release does not match lock tool_version")
          if artifact != f"agentic-repo-kit-{version}.pyz":
              raise SystemExit("distribution artifact does not match lock tool_version")

          url = (
              "https://github.com/"
              + repository
              + "/releases/download/"
              + quote(release, safe="")
              + "/"
              + quote(artifact, safe="")
          )
          print(f"url={url}")
          print(f"artifact={artifact}")
          print(f"sha256={digest}")
          PY

      - name: Download pinned kit artifact
        shell: bash
        env:
          KIT_URL: ${{ steps.kit.outputs.url }}
          KIT_ARTIFACT: ${{ steps.kit.outputs.artifact }}
        run: |
          set -euo pipefail
          path="$RUNNER_TEMP/$KIT_ARTIFACT"
          curl --fail --location --proto '=https' --tlsv1.2 --retry 3 \
            --output "$path" "$KIT_URL"
          echo "KIT_PATH=$path" >> "$GITHUB_ENV"

      - name: Verify pinned kit artifact
        shell: bash
        env:
          EXPECTED_SHA256: ${{ steps.kit.outputs.sha256 }}
        run: |
          set -euo pipefail
          actual="$(sha256sum "$KIT_PATH" | awk '{print $1}')"
          if [[ "$actual" != "$EXPECTED_SHA256" ]]; then
            echo "agentic-repo-kit artifact digest mismatch: actual=$actual expected=$EXPECTED_SHA256" >&2
            exit 1
          fi

      - name: Check repository contract
        run: python "$KIT_PATH" check .
