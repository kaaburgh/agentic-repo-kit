{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaaburgh.github.io/agentic-repo-kit/repository-config.schema.json",
  "title": "agentic-repo-kit repository configuration",
  "type": "object",
  "required": ["kit_version", "profiles", "project"],
  "properties": {
    "kit_version": {"type": "integer", "minimum": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "project": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "roadmap": {"type": "string", "minLength": 1, "default": "ROADMAP.md"}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "cloud_first": {"type": "boolean", "default": true}
      },
      "additionalProperties": false
    },
    "local": {
      "type": "object",
      "properties": {
        "policy_files": {"type": "array", "items": {"type": "string"}},
        "playbook_files": {"type": "array", "items": {"type": "string"}},
        "pr_files": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
